FROM golang:1.27.3@sha256:2920bb124f1a2e12a1d39f0cab756ae0068441ee1da7655dec7f5e374944095b AS build
WORKDIR /src
COPY go.mod go.sum ./
COPY test/spiffe/dbprobe ./test/spiffe/dbprobe
COPY pkg ./pkg
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -mod=mod -trimpath -o /probe ./test/spiffe/dbprobe
FROM build AS crud-tests
COPY test/integration ./test/integration
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build go test -race -c -o /orders.test ./test/integration
ENTRYPOINT ["/orders.test", "-test.run", "^TestVitessOrders$", "-test.v"]

FROM gcr.io/distroless/static-debian13@sha256:15f8637509792e05b97d83451b0b6ccfa4abd548f997e406ac1e72c87fe1fa78 AS probe-runtime
USER 65532:65532
COPY --from=build /probe /probe
ENTRYPOINT ["/probe"]
