{
  "admin": {
    "address": {
      "socket_address": {
        "address": "127.0.0.1",
        "port_value": 9901
      }
    }
  },
  "node": {
    "cluster": "service-auth",
    "id": "envoy-payment"
  },
  "overload_manager": {
    "resource_monitors": [
      {
        "name": "envoy.resource_monitors.global_downstream_max_connections",
        "typed_config": {
          "@type": "type.googleapis.com/envoy.extensions.resource_monitors.downstream_connections.v3.DownstreamConnectionsConfig",
          "max_active_downstream_connections": 256
        }
      }
    ]
  },
  "static_resources": {
    "clusters": [
      {
        "connect_timeout": "1s",
        "load_assignment": {
          "cluster_name": "spire_agent",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "pipe": {
                        "path": "/run/spire/agent/agent.sock"
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "name": "spire_agent",
        "type": "STATIC",
        "typed_extension_protocol_options": {
          "envoy.extensions.upstreams.http.v3.HttpProtocolOptions": {
            "@type": "type.googleapis.com/envoy.extensions.upstreams.http.v3.HttpProtocolOptions",
            "explicit_http_config": {
              "http2_protocol_options": {}
            }
          }
        }
      },
      {
        "connect_timeout": "2s",
        "load_assignment": {
          "cluster_name": "payment-app",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": 50051
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "name": "payment-app",
        "type": "STRICT_DNS"
      },
      {
        "connect_timeout": "2s",
        "load_assignment": {
          "cluster_name": "vitess-grpc-mtls",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "envoy-vitess",
                        "port_value": 8446
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "name": "vitess-grpc-mtls",
        "transport_socket": {
          "name": "envoy.transport_sockets.tls",
          "typed_config": {
            "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.UpstreamTlsContext",
            "common_tls_context": {
              "combined_validation_context": {
                "default_validation_context": {
                  "match_typed_subject_alt_names": [
                    {
                      "matcher": {
                        "exact": "spiffe://service-auth.test/vtgate"
                      },
                      "san_type": "URI"
                    }
                  ]
                },
                "validation_context_sds_secret_config": {
                  "name": "spiffe://service-auth.test",
                  "sds_config": {
                    "api_config_source": {
                      "api_type": "GRPC",
                      "grpc_services": [
                        {
                          "envoy_grpc": {
                            "cluster_name": "spire_agent"
                          }
                        }
                      ],
                      "transport_api_version": "V3"
                    },
                    "resource_api_version": "V3"
                  }
                }
              },
              "tls_certificate_sds_secret_configs": [
                {
                  "name": "spiffe://service-auth.test/payment",
                  "sds_config": {
                    "api_config_source": {
                      "api_type": "GRPC",
                      "grpc_services": [
                        {
                          "envoy_grpc": {
                            "cluster_name": "spire_agent"
                          }
                        }
                      ],
                      "transport_api_version": "V3"
                    },
                    "resource_api_version": "V3"
                  }
                }
              ],
              "tls_params": {
                "tls_maximum_protocol_version": "TLSv1_3",
                "tls_minimum_protocol_version": "TLSv1_3"
              }
            }
          }
        },
        "type": "STRICT_DNS"
      },
      {
        "connect_timeout": "2s",
        "load_assignment": {
          "cluster_name": "application-metrics",
          "endpoints": [
            {
              "lb_endpoints": [
                {
                  "endpoint": {
                    "address": {
                      "socket_address": {
                        "address": "127.0.0.1",
                        "port_value": 9090
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        "name": "application-metrics",
        "type": "STRICT_DNS"
      }
    ],
    "listeners": [
      {
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8447
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.tcp_proxy",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy",
                  "cluster": "payment-app",
                  "idle_timeout": "30s",
                  "max_downstream_connection_duration": "30s",
                  "stat_prefix": "payment-inbound"
                }
              }
            ],
            "transport_socket": {
              "name": "envoy.transport_sockets.tls",
              "typed_config": {
                "@type": "type.googleapis.com/envoy.extensions.transport_sockets.tls.v3.DownstreamTlsContext",
                "common_tls_context": {
                  "combined_validation_context": {
                    "default_validation_context": {
                      "match_typed_subject_alt_names": [
                        {
                          "matcher": {
                            "exact": "spiffe://service-auth.test/service-b"
                          },
                          "san_type": "URI"
                        }
                      ]
                    },
                    "validation_context_sds_secret_config": {
                      "name": "spiffe://service-auth.test",
                      "sds_config": {
                        "api_config_source": {
                          "api_type": "GRPC",
                          "grpc_services": [
                            {
                              "envoy_grpc": {
                                "cluster_name": "spire_agent"
                              }
                            }
                          ],
                          "transport_api_version": "V3"
                        },
                        "resource_api_version": "V3"
                      }
                    }
                  },
                  "tls_certificate_sds_secret_configs": [
                    {
                      "name": "spiffe://service-auth.test/payment",
                      "sds_config": {
                        "api_config_source": {
                          "api_type": "GRPC",
                          "grpc_services": [
                            {
                              "envoy_grpc": {
                                "cluster_name": "spire_agent"
                              }
                            }
                          ],
                          "transport_api_version": "V3"
                        },
                        "resource_api_version": "V3"
                      }
                    }
                  ],
                  "tls_params": {
                    "tls_maximum_protocol_version": "TLSv1_3",
                    "tls_minimum_protocol_version": "TLSv1_3"
                  }
                },
                "require_client_certificate": true
              }
            }
          }
        ],
        "name": "inbound-payment"
      },
      {
        "address": {
          "socket_address": {
            "address": "127.0.0.1",
            "port_value": 15991
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.tcp_proxy",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.tcp_proxy.v3.TcpProxy",
                  "cluster": "vitess-grpc-mtls",
                  "idle_timeout": "30s",
                  "max_downstream_connection_duration": "30s",
                  "stat_prefix": "payment-db"
                }
              }
            ]
          }
        ],
        "name": "outbound-vitess-grpc"
      },
      {
        "address": {
          "socket_address": {
            "address": "0.0.0.0",
            "port_value": 8448,
            "protocol": "UDP"
          }
        },
        "filter_chains": [
          {
            "filters": [
              {
                "name": "envoy.filters.network.http_connection_manager",
                "typed_config": {
                  "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
                  "codec_type": "HTTP3",
                  "common_http_protocol_options": {
                    "idle_timeout": "30s",
                    "max_connection_duration": "30s"
                  },
                  "forward_client_cert_details": "SANITIZE",
                  "http3_protocol_options": {},
                  "http_filters": [
                    {
                      "name": "envoy.filters.http.router",
                      "typed_config": {
                        "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
                      }
                    }
                  ],
                  "normalize_path": true,
                  "request_timeout": "10s",
                  "route_config": {
                    "name": "metrics-inbound",
                    "request_headers_to_remove": [
                      "x-spiffe-id",
                      "x-forwarded-client-cert"
                    ],
                    "virtual_hosts": [
                      {
                        "domains": [
                          "*"
                        ],
                        "name": "metrics-inbound",
                        "routes": [
                          {
                            "match": {
                              "headers": [
                                {
                                  "name": ":method",
                                  "string_match": {
                                    "exact": "GET"
                                  }
                                }
                              ],
                              "path": "/metrics"
                            },
                            "route": {
                              "cluster": "application-metrics",
                              "timeout": "3s"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "stat_prefix": "metrics-inbound",
                  "stream_idle_timeout": "10s"
                }
              }
            ],
            "transport_socket": {
              "name": "envoy.transport_sockets.quic",
              "typed_config": {
                "@type": "type.googleapis.com/envoy.extensions.transport_sockets.quic.v3.QuicDownstreamTransport",
                "downstream_tls_context": {
                  "common_tls_context": {
                    "combined_validation_context": {
                      "default_validation_context": {
                        "match_typed_subject_alt_names": [
                          {
                            "matcher": {
                              "exact": "spiffe://service-auth.test/metrics-collector"
                            },
                            "san_type": "URI"
                          }
                        ]
                      },
                      "validation_context_sds_secret_config": {
                        "name": "spiffe://service-auth.test",
                        "sds_config": {
                          "api_config_source": {
                            "api_type": "GRPC",
                            "grpc_services": [
                              {
                                "envoy_grpc": {
                                  "cluster_name": "spire_agent"
                                }
                              }
                            ],
                            "transport_api_version": "V3"
                          },
                          "resource_api_version": "V3"
                        }
                      }
                    },
                    "tls_certificate_sds_secret_configs": [
                      {
                        "name": "spiffe://service-auth.test/payment",
                        "sds_config": {
                          "api_config_source": {
                            "api_type": "GRPC",
                            "grpc_services": [
                              {
                                "envoy_grpc": {
                                  "cluster_name": "spire_agent"
                                }
                              }
                            ],
                            "transport_api_version": "V3"
                          },
                          "resource_api_version": "V3"
                        }
                      }
                    ],
                    "tls_params": {
                      "tls_maximum_protocol_version": "TLSv1_3",
                      "tls_minimum_protocol_version": "TLSv1_3"
                    }
                  },
                  "require_client_certificate": true
                },
                "enable_early_data": false,
                "enable_resumption": false
              }
            }
          }
        ],
        "name": "inbound-metrics",
        "udp_listener_config": {
          "quic_options": {}
        }
      }
    ]
  }
}
