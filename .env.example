# Placeholders only: configure your external IdP and inject credentials securely.
OIDC_ISSUER=https://identity.example.test
OIDC_JWKS_URL=https://identity.example.test/.well-known/jwks.json
OIDC_TOKEN_URL=https://identity.example.test/oauth/token
OAUTH_AUDIENCE=service-b
OAUTH_CLIENT_ID=replace-with-registered-client
OAUTH_CLIENT_SECRET=replace-with-client-secret
AUTH_ALLOWED_CLIENTS=replace-with-registered-client
OAUTH_AUTH_METHOD=client_secret_basic
OAUTH_SCOPES=orders:read orders:write
# Optional provider parameter. Leave the resource empty for standard OAuth requests.
OAUTH_RESOURCE=
OAUTH_RESOURCE_PARAMETER=resource
JWT_TOKEN_TYPE=at+jwt
JWT_CLIENT_ID_CLAIM=client_id
JWT_SCOPE_CLAIM=scope
JWT_ROLES_CLAIM=roles
JWT_TOKEN_USE_CLAIM=
JWT_TOKEN_USE_VALUE=
JWT_MAX_LIFETIME=10m
# Only the local A -> B demo connection may use HTTP. IdP endpoints always require HTTPS.
SERVICE_B_URL=http://service-b:8080
ALLOW_HTTP_RESOURCE=true
# SPIFFE Compose fixes this to B's local Envoy. Standalone Compose needs a reachable VTGate.
VTGATE_ADDRESS=127.0.0.1:15991
VTGATE_TARGET=commerce@primary
VTGATE_MAX_OPEN_CONNS=10
VTGATE_MAX_IDLE_CONNS=5
VTGATE_TIMEOUT=5s
VTGATE_CONN_LIFETIME=5m
VTGATE_CONN_IDLE_TIME=1m
